[Unit]
Description=HomeServer Docker Compose — core (no HDD required)
Documentation=https://github.com/minipc/HomeServer
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/minipc/HomeServer
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
User=minipc
Group=docker

[Install]
WantedBy=multi-user.target
