[Unit]
Description=Telegram Data Hub Docker Compose
Documentation=https://github.com/minipc/telegram-data-hub
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/minipc/telegram-data-hub
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
User=minipc
Group=docker

[Install]
WantedBy=multi-user.target
